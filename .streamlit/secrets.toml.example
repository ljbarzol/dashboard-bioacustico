# Copie este archivo como .streamlit/secrets.toml (local) o pegue su contenido en
# Streamlit Community Cloud > App > Settings > Secrets.
# NUNCA suba secrets.toml al repositorio (ya está en .gitignore).

# Opcional: carpeta de Drive a leer (enlace o ID). Si se omite, se usa config.yaml.
[drive]
folder_id = "1yjJKnCO6NgIXe88RHFza3SsOC1mC0Twf"

# Contenido del JSON de la cuenta de servicio, campo por campo.
# La private_key va entre comillas triples (o en una línea con \n).
[gcp_service_account]
type = "service_account"
project_id = "su-proyecto"
private_key_id = "0000000000000000000000000000000000000000"
private_key = """-----BEGIN PRIVATE KEY-----
PEGUE_AQUI_LA_CLAVE
-----END PRIVATE KEY-----
"""
client_email = "dashboard-lector@su-proyecto.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/dashboard-lector%40su-proyecto.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
